# SAM3 video annotation app — copy to .env and adjust as needed.
# All have sensible defaults, so .env is optional for local use.

# Directory the app lists/serves clips from (also where in-app uploads land).
VIDEO_DIR=data/videos

# SQLite annotation store (created on first run).
ANNOTATION_DB=outputs/annotations.db

# Port the app serves on.
PORT=8080

# Optional: Hugging Face token, only if downloading facebook/sam3 requires auth.
# HF_TOKEN=

# Remote SAM3 service (set SAM3_URL to offload inference; leave unset to run locally)
# SAM3_URL=https://<your-sam3-service>
SAM3_API_KEY=        # from the team secret store — never commit
SAM3_TIMEOUT=300
SAM3_READY_TIMEOUT=300
